{
  "defaultAction": "SCMP_ACT_ERRNO",
  "architectures": [
    "SCMP_ARCH_X86_64",
    "SCMP_ARCH_AARCH64"
  ],
  "syscalls": [
    {
      "names": [
        "accept", "accept4", "bind", "connect", "listen",
        "recvfrom", "sendto", "read", "write", "open", "openat",
        "close", "fstat", "fstatat", "lseek", "mmap", "mprotect",
        "munmap", "brk", "rt_sigaction", "rt_sigprocmask",
        "rt_sigreturn", "clone", "execve", "exit", "exit_group",
        "getpid", "getuid", "getgid", "geteuid", "getegid",
        "socket", "setsockopt", "getsockopt", "fcntl", "ioctl",
        "poll", "epoll_create", "epoll_ctl", "epoll_wait",
        "nanosleep", "clock_gettime", "futex", "set_robust_list",
        "arch_prctl", "access", "stat", "lstat", "readlink",
        "getcwd", "chdir", "mkdir", "rmdir", "unlink", "rename",
        "pipe", "pipe2", "dup", "dup2", "dup3",
        "prctl", "seccomp",
        "perf_event_open", "bpf"
